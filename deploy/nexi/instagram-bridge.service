# The one Instagram connection, fanned out to the MCP sessions over SSE.
# Settings come from .env in the working directory.
[Unit]
Description=Instagram bridge (single Instagram connection, SSE fan-out)
After=network-online.target
Wants=network-online.target
# A broken build must not hammer Instagram with session logins: give up after
# 5 failed starts in 10 minutes (the next deploy starts it again).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=%h/Documents/informatik/instagram-mcp
# Traces and metrics over OTLP/HTTP to the local Alloy. Logs stay out of OTLP: the
# bridge writes JSON lines to stdout, the journal keeps them and Alloy ships those.
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
Environment=OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
Environment=OTEL_METRIC_EXPORT_INTERVAL=15000
Environment=OTEL_LOGS_EXPORTER=none
ExecStart=%h/.local/bin/uv run --frozen instagram-bridge
Restart=always
RestartSec=5
# uvicorn shuts down cleanly on SIGTERM and then re-raises the signal, so `uv run`
# exits 143: that is a normal stop, not a failure.
SuccessExitStatus=143

[Install]
WantedBy=default.target
